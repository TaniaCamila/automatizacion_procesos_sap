# =============================================================================
# Plantilla .env — Operations Analytics (Capstone / entorno local)
# Copiar a .env y completar. NO publicar secretos ni rutas personales.
# =============================================================================

# --- Extracción SAP (script VBS externo; no versionar el .vbs ni credenciales) ---
# Ruta absoluta al script cscript en el PC autorizado.
SAP_FBL1N_VBS_PATH=

# --- FBL1N futuro (combinado histórico + extracción) ---
FBL1N_FUTURE_ENABLED=true
# Absoluta o relativa a ROOT_DIR. Ejemplo: C:\Ruta\Entrada\FBL1N_FUTURO.xlsx
# FBL1N_FUTURE_PATH=

# Corte de Fecha compensación (YYYY-MM-DD). Fallback en modo static.
FBL1N_COMPENSATION_CUTOFF=2026-08-31
# static | max_source_date
FBL1N_COMPENSATION_CUTOFF_MODE=max_source_date

# --- Correo ---
MAIL_AUTO_SEND=false
# 0=lunes … 4=viernes … 6=domingo
MAIL_SEND_WEEKDAY=4
# Destinatarios solo en .env local (no hardcodear en código).
# MAIL_TO=usuario@empresa.example
# MAIL_CC=
# MAIL_BCC=
# MAIL_SENDER_ACCOUNT=
# MAIL_SHAREPOINT_LINK=
# MAIL_POWERBI_LINK=

# --- SharePoint (opcional; valores desde variables de entorno) ---
# SHAREPOINT_SITE_URL=
# SHAREPOINT_DOCUMENT_LIBRARY=
# SHAREPOINT_TARGET_FOLDER=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_SECRET=
